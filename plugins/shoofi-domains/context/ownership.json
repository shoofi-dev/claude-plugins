        "screens/delivery-driver/",
        "hooks/useDriverLocationTracking.ts",
        "utils/locationBackgroundTask.ts",
        "services/driverShiftService.ts",
        "consts/shared.ts"
      ],
      "shoofi-delivery-web": [
        "src/apis/admin/delivery/",
        "src/apis/delivery/",
        "src/views/admin/delivery-areas/",
        "src/views/admin/driver-locations/",
        "src/views/admin/driver-shifts/",
        "src/views/admin/DeliveryMonitor.tsx",
        "src/views/admin/settings/DeliverySettings.tsx",
        "src/consts/shared.ts"
      ],
      "shoofi-partner": ["hooks/useAvailableDrivers.ts", "screens/book-delivery/"]
