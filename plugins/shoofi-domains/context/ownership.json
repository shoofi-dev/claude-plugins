      "shoofi-partner": ["screens/login", "screens/verify-code", "stores/auth/", "stores/user-details/"],
      "shoofi-shoofir": ["screens/login", "screens/verify-code", "stores/auth/", "stores/user-details/"],
      "shoofi-delivery-web": [
        "src/contexts/AdminAuthContext.tsx",
        "src/views/admin/users/",
        "src/components/ProtectedRoute.tsx",
        "src/components/RoleBasedAccess.tsx"
      ]
