        {
          "file": "routes/product.js",
          "regex": "req\\.body\\.price !== undefined",
          "desc": "doc CORE invariant 8: omitting `price` leaves the stored one alone — how a bulk tool skips a price"
        },
        {
          "file": "utils/order-pricing.js",
          "regex": "if \\(isFree \\|\\| remainingFreeCount > 0\\)",
          "desc": "doc reference \u00a74: an isFree-stamped topping is free WITHOUT decrementing remainingFreeCount, so freeCount: N gives away up to 2N. If this line changes, the defect note in reference \u00a74 must be re-checked."
        },
        {
          "file": "utils/order-pricing.js",
          "regex": "if \\(area && area.price\\)",
          "desc": "doc reference \u00a74: truthiness test, so an area priced 0 falls through to the option-level price"
        },
        {
          "file": "routes/admin/menu-import-issues.js",
          "regex": "menuImportIssues",
          "desc": "doc reference \u00a72: the per-store import-issues worklist. If this stops matching, the collection moved or was removed and the screen it feeds is dead."
        },
        {
          "file": "routes/menu.js",
          "regex": "store.hasGeneralCategories",
          "desc": "doc reference \u00a72: the menu reads this flag from the PER-STORE store doc, while the admin form writes central shoofi.stores. If this line changes, re-check the two-document drift note."
        },
        {
          "file": "utils/catalog-lint.js",
          "regex": "REJECT_CODES = new Set\\(\\[\"PIZZA_AREA_VOCAB\", \"SINGLE_WITHOUT_OPTIONS\"\\]\\)",
          "desc": "doc CORE invariant 9: exactly these two codes are refused at the write boundary; everything else is repaired or saved+recorded"
        },
        {
          "file": "routes/product.js",
          "regex": "CATALOG_INVALID",
          "desc": "doc CORE invariant 9: the 400 body the admin form keys on"
        },
        {
          "file": "routes/product.js",
          "regex": "lintForWrite",
          "desc": "doc CORE invariant 9: insert / update / create-from-mock all lint before the write"
        },
        {
          "file": "routes/product.js",
          "regex": "if \\(req\\.body\\.extras !== undefined\\) \\{\\n      updateLint",
          "desc": "doc CORE invariant 9: update lints only when the save sends extras"
