        {
          "file": "consts/consts.js",
          "regex": "ORDER_STATUS",
          "desc": "authoritative order status enum"
        },
        {
          "file": "services/database/DatabaseInitializationService.js",
          "regex": "db\\.customerCoins = db\\.collection\\('customer-coins'\\)",
          "desc": "the coins collection is really named customer-coins - the db.customerCoins handle is the only thing that maps it, so a mongosh query on the camelCase name silently returns 0 rows"
        },
        {
          "file": "services/coins/coins-service.js",
          "regex": "if \\(!storeCoinsActive && availableBalance <= 0\\) continue;",
          "desc": "getAllCustomerCoins is a WALLET view that hides stores spent down to zero - if this guard goes, the CORE warning to use totalEarned > 0 for an earnings view is stale"
        },
        {
          "file": "services/coins/coin-buckets.js",
          "regex": "return Math\\.max\\(0, balance - expiredUnconsumed\\);",
          "desc": "spendable balance is the ledger replay, not the stored balance pool - if this changes, so does every coins figure the docs describe"
        },
        {
          "file": "services/coins/coin-buckets.js",
          "regex": "tx\\.type === 'expire' && tx\\.orderId == null",
          "desc": "an expire transaction is overloaded - orderId null is the sweep, non-null is a per-order clawback. This branch is the only thing that tells them apart"
        },
        {
          "file": "routes/order.js",
          "regex": "persistentAlertsService\\.sendPersistentAlert",
          "desc": "the store-owner new-order alert is delegated to utils/persistent-alerts.js, not sent through services/notification directly"
        },
        {
          "file": "utils/crons/persistent-alerts-cron.js",
          "regex": "cron\\.schedule\\('\\*/1 \\* \\* \\* \\*'",
          "desc": "the store-alert reminder cron runs every minute - if this interval changes, the reminder cadence in reference.md is wrong"
        },
        {
          "file": "utils/persistent-alerts.js",
          "regex": "//\\s*\\{ \"lastReminderSent\\._d\": \\{ \\$lt: oneMinuteAgo \\}",
          "desc": "the reminder throttle is still commented out, so reminderCount < 5 is the only brake - when this is uncommented the per-minute claim in reference.md must be corrected"
        },
        {
          "file": "consts/consts.js",
          "regex": "FRAUD_REVIEW:\\s*\"13\"",
          "desc": "FRAUD_REVIEW = 13 (doc CORE state machine)"
        },
        {
          "file": "consts/consts.js",
          "regex": "FUTURE_ORDER_PENDING:\\s*\"14\"",
          "desc": "FUTURE_ORDER_PENDING = 14"
        },
        {
          "file": "routes/order.js",
          "regex": "/api/order/update/viewd",
          "desc": "store-accept endpoint (6->1 transition)"
        },
        {
          "file": "routes/order.js",
          "regex": "twinGroup",
          "desc": "twin linkage field on orders"
        },
        {
          "file": "routes/order.js",
          "regex": "isFutureOrder:\\s*\\{\\s*\\$exists:\\s*false\\s*\\}",
          "desc": "server treats isFutureOrder as absent-when-false (CORE invariant 9)"
        },
        {
          "file": "routes/order.js",
          "regex": "originalOrderDate:\\s*order\\.originalOrderDate \\|\\| order\\.orderDate",
          "desc": "update-delay freezes the pre-delay order date ONCE while orderDate accumulates (CORE invariant 10)"
        },
        {
          "file": "routes/order.js",
          "regex": "originalPickupTime:\\s*deliveryRecord\\.originalPickupTime \\|\\| deliveryRecord\\.pickupTime",
          "desc": "same preserve-once idiom on the bookDelivery row; pickupTime itself accumulates and is NOT wrapped at 24"
        },
        {
          "file": "routes/order.js",
          "regex": "originalExpectedDeliveryAt =\\s*\\n?\\s*deliveryRecord\\.originalExpectedDeliveryAt \\|\\| deliveryRecord\\.expectedDeliveryAt",
          "desc": "the frozen pre-shift promise - the operand services/delivery/late-delivery.js pairs with originalPickupTime to keep the zero-ETA sentinel readable after a delay"
        },
        {
          "file": "routes/order.js",
          "regex": "updateData\\.startPreparingAt\\s*=",
          "desc": "future accept sets startPreparingAt and does NOT rewrite orderDate (ref §2)"
        },
        {
          "file": "routes/order.js",
          "regex": "originalOrderDate",
          "desc": "/update-delay shifts orderDate and preserves the original (ref §5)"
        },
        {
          "file": "routes/app-logs.js",
          "regex": "created: new Date\\(\\)",
          "desc": "apps-logs.created is a real BSON Date — the opposite of orders.created, which is an offset string (CORE: where an order that never happened lives)"
        },
        {
          "file": "routes/app-logs.js",
          "regex": "user_visit_id",
          "desc": "the device-id header, the stable installation identity abandoned-cart sessions are keyed on — NOT orders.deviceId"
