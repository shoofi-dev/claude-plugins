        "controllers/customerAddressController.js",
        "utils/customer-orders.js",
        "docs/customer-orders-snapshot.md",
        "routes/order.js",
        "package.json"
      ],
      "symbols": {
        "services/database/DatabaseInitializationService.js": ["store-users", "persistent-alerts"],
        "utils/auth-service.js": ["generateJWT", "toAuthJSON"],
        "utils/app-name-helper.js": ["getCustomerAppName"],
        "utils/customer-orders.js": [
          "COMPLETED_STATUSES",
          "CANCELLED_STATUSES",
          "summarizeOrderStatuses"
        ],
        "utils/admin-auth-service.js": [
          "generateAccessToken",
          "verifyAccessToken",
          "verifyAdminCredentials"
        ],
        "routes/customer-referrals.js": [
          "attributeCustomerToReferrer",
          "recordFirstOrderForReferrer"
        ],
        "routes/customer.js": ["validateAuthCode", "authCode", "switch-store"]
      },
      "patterns": [
        {
          "file": "routes/auth.js",
          "regex": "app-type",
          "desc": "identity routing is by app-type, not app-name"
        },
        {
          "file": "routes/customer.js",
          "regex": "shoofi-shoofir",
          "desc": "driver identity branch -> delivery-company.customers"
        },
        {
          "file": "routes/customer.js",
          "regex": "storeUsers",
          "desc": "partner identity collection"
        },
        {
          "file": "utils/app-name-helper.js",
          "regex": "shoofi",
          "desc": "customers are central: getCustomerAppName always returns shoofi"
        },
        {
          "file": "utils/customer-orders.js",
          "regex": "COMPLETED_STATUSES = \\[\"2\", \"3\", \"10\", \"11\", \"12\"\\]",
          "desc": "the report-path definition of a real order is strictly fulfilled - deliberately stricter than the customer-facing count"
        },
        {
          "file": "utils/customer-orders.js",
          "regex": "CANCELLED_STATUSES = \\[\"4\", \"5\", \"7\", \"8\", \"9\"\\]",
          "desc": "there is no single cancelled status - five of them, and summarizeOrderStatuses buckets on this set"
        },
        {
          "file": "routes/customer.js",
          "regex": "invalidStatuses = \\[\"0\", \"4\", \"5\", \"7\", \"8\", \"9\"\\]",
          "desc": "the customer-facing order count excludes only never-charged (0) + cancelled, so in-flight orders count - it is looser than COMPLETED_STATUSES on purpose"
        },
        {
          "file": "routes/customer.js",
          "regex": "customer/orders\"[\\s\\S]{0,3600}summarizeOrderStatuses",
          "desc": "the admin profile badge count comes from the store-level status join, never from customers.orders[].length - the bounded tail pins the summary to the orders handler"
        },
        {
          "file": "routes/customer.js",
          "regex": "customer/logout\"[\\s\\S]{0,2400}storeUsers\\.updateMany",
          "desc": "logout sweeps every storeUsers doc sharing the phone - the bounded tail pins the sweep to the logout handler, and it only appears once logout resolves the identity doc by app-type at all (shoofi-server#47)"
        },
        {
          "file": "routes/customer.js",
          "regex": "storeUsers\\.updateMany\\([\\s\\S]{0,120}notificationToken: req\\.body\\.notificationToken",
          "desc": "update-notification-token mirrors the device push token onto every sibling storeUsers doc for the phone (shoofi-server#46) - the mirrored value is what distinguishes this updateMany from the logout sweep (nulls) and the OTP sweep (authCode)"
        },
        {
          "file": "package.json",
          "regex": "\"express-jwt\": \"\\^8",
          "desc": "express-jwt v8 writes the verified payload to req.auth - v5's req.user default is gone"
        },
        {
          "file": "routes/auth.js",
          "regex": "userProperty: \"auth\"",
          "desc": "the authenticated user is req.auth, never req.user - nothing in the codebase assigns req.user"
        },
        {
          "file": "routes/customer.js",
          "regex": "created: new Date\\(\\)",
          "desc": "customers.created is a real BSON Date - a string bound will never match it"
        },
        {
          "file": "routes/order.js",
          "regex": "created: moment\\(new Date\\(\\)\\)\\.utcOffset\\(offsetHours\\)\\.format\\(\\)",
          "desc": "orders.created - and the customers.orders[] snapshot of it - is an ISO string with an Israel offset, the opposite type from customers.created on the same document"
        }
      ]
    },
    "shoofi-partner": {
      "files": ["stores/auth/index.ts", "stores/user-details/index.tsx"],
      "patterns": [
        {
          "file": "stores/auth/index.ts",
          "regex": "switchStore",
          "desc": "per-store token re-mint mechanism"
        }
      ]
    },
    "shoofi-delivery-web": {
      "files": [
        "src/contexts/AdminAuthContext.tsx",
        "src/utils/http-interceptor/index.ts",
        "src/views/admin/customers/CustomerSearch.tsx",
        "src/views/admin/StoreDeliveryAvailabilityAlerts.tsx"
      ],
      "symbols": {
        "src/views/admin/StoreDeliveryAvailabilityAlerts.tsx": ["REASON_LABELS"]
      },
      "patterns": [
        {
          "file": "src/utils/http-interceptor/index.ts",
          "regex": "Bearer",
          "desc": "admin uses Bearer (RN apps use 'Token')"
        },
        {
          "file": "src/views/admin/customers/CustomerSearch.tsx",
          "regex": "[\\u0590-\\u05FF]",
          "desc": "admin Hebrew is a literal in the component - no i18n layer in the admin web"
        },
        {
          "file": "src/views/admin/StoreDeliveryAvailabilityAlerts.tsx",
          "regex": "\\|\\| a\\.reason",
          "desc": "enum label maps are read with a || code fallback so unknown codes render"
        }
      ]
    }
  }
}
