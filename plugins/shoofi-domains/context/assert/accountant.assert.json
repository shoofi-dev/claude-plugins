      ],
      "symbols": {
        "lib/payments/calc.js": [
          "getFullDiscountMatrix",
          "effectiveDeliveryFee",
          "couponDeliveryPortion",
          "couponDeliverySplit",
          "isPercentageStoreDeliveryCoupon",
          "calculateCommission",
          "getDateRange"
        ],
        "utils/vat.js": [
          "VAT_RATE",
          "VAT_MULTIPLIER",
          "calculateVAT",
          "withoutVAT",
          "withoutVATIfExempt"
        ],
        "routes/payments/admin-reports.js": [
          "checkOverlappingReports",
          "validateOrdersClosed",
          "calculateCommissionTiered",
          "generateStoreReportData",
          "totalForTransfer"
        ],
        "utils/invoice-provider.js": ["getActiveProvider"]
      },
      "patterns": [
        {
          "file": "routes/payments/admin-reports.js",
          "regex": "totalForTransfer\\s*=\\s*creditCardRevenue",
          "desc": "CORE money formula: transfer is credit-card revenue minus outcomes"
        },
        {
          "file": "routes/payments/admin-reports.js",
          "regex": "const balance\\s*=\\s*totalForTransfer",
          "desc": "the bank transfer is the raw transfer amount — no ÷1.18 for exempt stores, whose prices carry no VAT (must stay in step with totalForInvoice in routes/hyp.js)"
        },
        {
          "file": "routes/payments/admin-reports.js",
          "regex": "revenueForCommission\\s*=\\s*totalRevenue\\s*\\+\\s*totalCustomerSpecificCoupons\\s*\\+\\s*totalShoofiCompensations\\s*\\+\\s*driveInTotal\\s*;",
          "desc": "commission is charged on the FINAL items price charged — productDiscounts must NOT be added back here (owner decision 2026-08-04), while reimbursed coupons, Shoofi compensations and drive-in stay in"
        },
        {
          "file": "routes/payments/admin.js",
          "regex": "totalRevenueCreditCard\\s*\\+=\\s*chargedOrderPrice",
          "desc": "card revenue is the price actually charged, not the pre-discount list price"
        },
        {
          "file": "routes/driver-reports.js",
          "regex": "actualDriverPayment",
          "desc": "cash-vs-card driver payout branch"
        },
        {
          "file": "routes/payments/admin.js",
          "regex": "if\\s*\\(storeDiscount\\s*&&\\s*!isSpecificToCustomers\\s*&&\\s*appliedCoupon\\.coupon\\?\\.discountType\\s*!==\\s*'full_discount'\\)",
          "desc": "CORE invariant 7: the store is billed a coupon's nominal storeDiscount whenever it is not customer-specific and not full_discount — the gate is blind to discountType, so a delivery coupon lands here too"
        },
        {
          "file": "routes/payments/admin.js",
          "regex": "discountAmount\\s*=\\s*\\(storeDiscount\\s*/\\s*100\\)\\s*\\*\\s*orderPrice",
          "desc": "CORE invariant 7: a percentage-type coupon bills the store a percentage of the ITEMS subtotal even when its discountType is 'delivery' — couponDeliverySplit deliberately diverges and takes the share off order.shippingPrice instead (owner ruling 2026-08-12)"
        },
        {
          "file": "routes/admin/masav.js",
          "regex": "CP862|cp862",
          "desc": "MASAV DOS-Hebrew encoding"
        },
        {
          "file": "routes/payments/admin-reports.js",
          "regex": "appNameBackfill\\.reportId'\\s*:\\s*getId\\(reportId\\)",
          "desc": "deleting a report releases its carry-over compensations back to pending, so the regenerated report re-bills them"
        }
      ]
    }
  }
}
