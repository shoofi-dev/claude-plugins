      "patterns": [
        {
          "file": "consts/consts.js",
          "regex": "DELIVERY_STATUS",
          "desc": "authoritative delivery status enum"
        },
        {
          "file": "consts/consts.js",
          "regex": "COLLECTED_FROM_RESTAURANT:\\s*\"3\"",
          "desc": "COLLECTED = 3 (clients must match; partner was off-by-one)"
        },
        {
          "file": "consts/consts.js",
          "regex": "DELIVERED:\\s*\"4\"",
          "desc": "DELIVERED = 4"
        },
        {
          "file": "routes/order.js",
          "regex": "isSendNotificationToDeliveryCompany",
          "desc": "global switch gating bookDelivery creation"
        },
        {
          "file": "services/database/DatabaseInitializationService.js",
          "regex": "db\\.bookDelivery\\s*=\\s*db\\.collection",
          "desc": "db.bookDelivery is bound to the hyphenated book-delivery collection"
        },
        {
          "file": "services/delivery/book-delivery.js",
          "regex": "\\.add\\(parseInt\\(result\\.area\\?\\.maxETA\\), 'minutes'\\)",
          "desc": "the immediate-assignment path adds maxETA with NO fallback - a missing or non-numeric value is a silent no-op, so expectedDeliveryAt comes out equal to pickupTime rather than invalid"
        },
        {
          "file": "services/delivery/delayed-assignment.js",
          "regex": "\\.add\\(parseInt\\(area\\?\\.maxETA \\|\\| 30\\), 'minutes'\\)",
          "desc": "the pending path's || 30 fallback rescues null/undefined/empty maxETA but not a non-numeric string - the asymmetry with the immediate path is the point"
        },
        {
          "file": "services/delivery/delayed-assignment.js",
          "regex": "useDelayedAssignment:\\s*false",
          "desc": "the CODE default is off and the code window is 10; production overrides both from delivery-company.delivery-config {type:'driver-assignment'} with true / 15. If this literal ever changes, the CORE note about reading the DB document rather than the constant needs rechecking"
        },
        {
          "file": "services/delivery/delayed-assignment.js",
          "regex": "assignmentWindowMinutes,\\s*'minutes'\\)",
          "desc": "dispatch is scheduled at pickupTime minus assignmentWindowMinutes - the same quantity the late-delivery grace measures from the other end"
        },
        {
          "file": "services/driver-shift/shift-service.js",
          "regex": "endHour\\s*\\+=\\s*24",
          "desc": "business day crosses midnight; every slot is stored under the STARTING date"
        },
        {
          "file": "services/driver-shift/shift-service.js",
          "regex": "getPermanentDriverSlotsForDay",
          "desc": "single per-weekday resolver; iterating the flat timeSlots over-books every weekday"
        },
        {
          "file": "utils/driver-active-hours.js",
          "regex": "WORKING_START_HOUR",
          "desc": "the one correct business-day window ([D 09:00, D+1 02:00]); feeds the paid guarantee"
        },
        {
          "file": "services/delivery/assignDriver.js",
          "regex": "areaQuery\\.isActive = true",
          "desc": "dispatch requires a STRICT isActive === true on an area - {$ne: false} is a different, wrong set"
        },
        {
          "file": "services/delivery/book-delivery.js",
          "regex": "\\.format\\(\"HH:mm\"\\)",
          "desc": "pickupTime is stored as a bare HH:mm wall clock, which wraps past midnight - it is not a timestamp"
        },
        {
          "file": "services/delivery/delayed-assignment.js",
          "regex": "pickupTimeDate\\.format\\(\"HH:mm\"\\)",
          "desc": "the pending path stores the same wrapping HH:mm clock"
        },
        {
          "file": "routes/order.js",
          "regex": "originalPickupTime",
          "desc": "update-delay moves pickupTime and does NOT recompute expectedDeliveryAt, so the stored promise belongs to originalPickupTime"
        },
        {
          "file": "services/delivery/late-delivery.js",
          "regex": "if \\(pickup\\.isBefore\\(created\\)\\) pickup\\.add\\(1, \"day\"\\)",
          "desc": "the midnight roll-forward: a pickup clock earlier than the booking means the next day (1,774 rows)"
        },
        {
          "file": "services/delivery/late-delivery.js",
          "regex": "delivery\\?\\.originalPickupTime \\|\\| delivery\\?\\.pickupTime",
          "desc": "the zero-minute-promise check reads the clock the promise was actually built from"
        },
        {
          "file": "routes/analytics.js",
          "regex": "eventType === .status_change. && ev\\.status === .3.",
          "desc": "the real store-ready source is orderFlowEvents status 3, keyed by orderNumber === bookDelivery.bookId - NOT a bookDelivery.storeReadyAt field, which nothing writes"
        },
        {
          "file": "utils/crons/growth-snapshots.js",
          "regex": "storeReadyAt",
          "desc": "the surviving storeReadyAt locals here read order.completedAt / orderFlowEvents, never bookDelivery.storeReadyAt (0 of 82,414 rows) - if a bookDelivery read reappears, the net-of-kitchen-delay lie is back"
        },
        {
          "file": "services/monitoring/centralized-flow-monitor.js",
          "regex": "logger\\.error\\('Failed to track centralized flow event:', error\\);\\s*\\n\\s*throw error;",
          "desc": "trackOrderFlowEvent rethrows - an unwrapped await on a dispatch route 5xxs the request after the write committed and skips the driver notifications"
        },
        {
          "file": "services/delivery/delivery-only.js",
          "regex": "deliveryOnlyStoreFee[\\s\\S]{0,120}deliveryOnlyDriverFee",
          "desc": "delivery-only fees are REGION (city-areas) values, not town values"
        },
        {
          "file": "services/delivery/delivery-only.js",
          "regex": "!platform\\?\\.isDeliveryOnlySupport\\s*&&\\s*!store\\?\\.isDeliveryOnlySupport",
          "desc": "the delivery-only gate is an OR of the platform and store flags"
        },
        {
          "file": "routes/delivery/admin.js",
          "regex": "updateData\\.isPendingAssignment\\s*=\\s*false",
          "desc": "a cancelled delivery stops being a delayed-assignment candidate (CORE invariant 10)"
        },
        {
          "file": "routes/delivery/orders.js",
          "regex": "\\[delivery-only\\] booked",
          "desc": "the booking success log line documented in docs/delivery-only-bookings.md"
        }
      ]
