          "desc": "DELIVERED = 4"
        },
        {
          "file": "routes/order.js",
          "regex": "isSendNotificationToDeliveryCompany",
          "desc": "global switch gating bookDelivery creation"
        },
        {
          "file": "services/database/DatabaseInitializationService.js",
          "regex": "db\\.bookDelivery\\s*=\\s*db\\.collection",
          "desc": "db.bookDelivery is bound to the hyphenated book-delivery collection"
        },
        {
          "file": "services/delivery/book-delivery.js",
          "regex": "\\.add\\(parseInt\\(result\\.area\\?\\.maxETA\\), 'minutes'\\)",
          "desc": "the immediate-assignment path adds maxETA with NO fallback - a missing or non-numeric value is a silent no-op, so expectedDeliveryAt comes out equal to pickupTime rather than invalid"
        },
        {
          "file": "services/delivery/delayed-assignment.js",
          "regex": "\\.add\\(parseInt\\(area\\?\\.maxETA \\|\\| 30\\), 'minutes'\\)",
          "desc": "the pending path's || 30 fallback rescues null/undefined/empty maxETA but not a non-numeric string - the asymmetry with the immediate path is the point"
        },
        {
          "file": "services/driver-shift/shift-service.js",
          "regex": "endHour\\s*\\+=\\s*24",
          "desc": "business day crosses midnight; every slot is stored under the STARTING date"
        },
        {
          "file": "services/driver-shift/shift-service.js",
          "regex": "getPermanentDriverSlotsForDay",
          "desc": "single per-weekday resolver; iterating the flat timeSlots over-books every weekday"
        },
        {
          "file": "utils/driver-active-hours.js",
          "regex": "WORKING_START_HOUR",
          "desc": "the one correct business-day window ([D 09:00, D+1 02:00]); feeds the paid guarantee"
        },
        {
          "file": "services/delivery/assignDriver.js",
          "regex": "areaQuery\\.isActive = true",
          "desc": "dispatch requires a STRICT isActive === true on an area - {$ne: false} is a different, wrong set"
        },
        {
          "file": "services/delivery/delayed-assignment.js",
          "regex": "useDelayedAssignment:\\s*false",
          "desc": "the code default is OFF but production's delivery-config doc sets it true - the scored path, not assignBestDeliveryDriver, is what actually runs (CORE.md invariant 10)"
        },
        {
          "file": "services/delivery/book-delivery.js",
          "regex": "config\\.useDelayedAssignment \\|\\| isTwin",
          "desc": "the single branch deciding pending-vs-immediate; with the prod flag on the left side is always true, so every order takes the scored path"
        },
        {
          "file": "services/delivery/driver-load.js",
          "regex": "ACTIVE_ORDER_STATUSES = \\[\"1\", \"2\", \"3\", \"5\"\\]",
          "desc": "in-flight includes \"5\" WAITING_IN_STORE - dropping it makes a driver holding orders inside a store score as fully idle (CORE.md invariant 11)"
        },
        {
          "file": "services/delivery/driver-load.js",
          "regex": "function getDriverCapacity",
          "desc": "maxOrdersByAdmin is null/0 for a blank cap on 116 of 238 driver records; comparing it literally excludes IDLE drivers from the candidate set"
        },
        {
          "file": "services/delivery/driver-load.js",
          "regex": "function getOrderPenalty",
          "desc": "extrapolates past the top orderPenalties rung; a Math.min(count,4) clamp makes the 5th order onward free and load stops mattering"
        },
        {
          "file": "services/delivery/delayed-assignment.js",
          "regex": "for \\(const delivery of pendingDeliveries\\)",
          "desc": "the pending tick runs SEQUENTIALLY so each assignment sees the previous one's status:1 write; Promise.allSettled here re-creates the burst pile-up"
        },
        {
          "file": "services/delivery/availability-status-service.js",
          "regex": "IN_FLIGHT_DELIVERY_STATUSES = ACTIVE_ORDER_STATUSES",
          "desc": "availability and dispatch share one in-flight list - they drifted apart once already"
        },
        {
          "file": "services/delivery/driver-load.js",
          "regex": "UNCOLLECTED_ORDER_STATUSES = \\[\"1\", \"2\", \"5\"\\]",
          "desc": "only \"3\" COLLECTED_FROM_RESTAURANT means the courier has the food; \"5\" WAITING_IN_STORE is a PRE-pickup state (CORE.md invariant 11)"
        },
        {
          "file": "services/delivery/driver-load.js",
          "regex": "function getUncollectedPenalty",
          "desc": "a courier still holding an uncollected pickup is stalled, not busy - handing him a second store makes both late (49.3% of production assignments did this)"
        },
        {
          "file": "services/delivery/driver-load.js",
          "regex": "function isWithinConcurrencyCap",
          "desc": "the 2-order cap is a sort TIER not a filter - emptying the candidate list strands the order because the immediate engine has no pending row to retry from"
        },
        {
          "file": "routes/delivery/orders.js",
          "regex": "startedAt: new Date\\(\\)",
          "desc": "the ONE place pickup is recorded; delivery status \"3\" is written alongside it and nowhere else stamps it"
        }
