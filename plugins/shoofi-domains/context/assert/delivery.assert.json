        "services/delivery/delayed-assignment.js": ["isPendingAssignment", "assignDriverAt"],
        "services/delivery/book-delivery.js": ["originalBookId"]
      },
      "patterns": [
        {
          "file": "consts/consts.js",
          "regex": "DELIVERY_STATUS",
          "desc": "authoritative delivery status enum"
        },
        {
          "file": "consts/consts.js",
          "regex": "COLLECTED_FROM_RESTAURANT:\\s*\"3\"",
          "desc": "COLLECTED = 3 (clients must match; partner was off-by-one)"
        },
        {
          "file": "consts/consts.js",
          "regex": "DELIVERED:\\s*\"4\"",
          "desc": "DELIVERED = 4"
        },
        {
          "file": "routes/order.js",
          "regex": "isSendNotificationToDeliveryCompany",
          "desc": "global switch gating bookDelivery creation"
        },
        {
          "file": "services/database/DatabaseInitializationService.js",
          "regex": "db\\.bookDelivery\\s*=\\s*db\\.collection",
          "desc": "db.bookDelivery is bound to the hyphenated book-delivery collection"
        },
        {
          "file": "services/delivery/book-delivery.js",
          "regex": "\\.add\\(parseInt\\(result\\.area\\?\\.maxETA\\), 'minutes'\\)",
          "desc": "the immediate-assignment path adds maxETA with NO fallback - a missing or non-numeric value is a silent no-op, so expectedDeliveryAt comes out equal to pickupTime rather than invalid"
        },
        {
          "file": "services/delivery/delayed-assignment.js",
          "regex": "\\.add\\(parseInt\\(area\\?\\.maxETA \\|\\| 30\\), 'minutes'\\)",
          "desc": "the pending path's || 30 fallback rescues null/undefined/empty maxETA but not a non-numeric string - the asymmetry with the immediate path is the point"
        },
        {
          "file": "services/driver-shift/shift-service.js",
          "regex": "endHour\\s*\\+=\\s*24",
          "desc": "business day crosses midnight; every slot is stored under the STARTING date"
        },
        {
          "file": "services/driver-shift/shift-service.js",
          "regex": "getPermanentDriverSlotsForDay",
          "desc": "single per-weekday resolver; iterating the flat timeSlots over-books every weekday"
        },
        {
          "file": "utils/driver-active-hours.js",
          "regex": "WORKING_START_HOUR",
          "desc": "the one correct business-day window ([D 09:00, D+1 02:00]); feeds the paid guarantee"
        },
        {
          "file": "services/delivery/assignDriver.js",
          "regex": "areaQuery\\.isActive = true",
          "desc": "dispatch requires a STRICT isActive === true on an area - {$ne: false} is a different, wrong set"
        },
        {
          "file": "routes/delivery/orders.js",
          "regex": "'order\\.order\\.address':\\s*1",
          "desc": "the driver-app list projects the embedded order LEAF BY LEAF - a new order field is dropped to undefined unless its dotted key is added here"
        },
        {
          "file": "routes/analytics.js",
          "regex": "'order\\.orderId':\\s*1",
          "desc": "the support board's deliveries projection is the same leaf-by-leaf whitelist - a nested order field has to be named in BOTH read paths, not just the driver one"
        },
        {
          "file": "services/delivery/book-delivery.js",
          "regex": "\\.\\.\\.deliveryData",
          "desc": "bookDelivery embeds the WHOLE order document, which is why a new order field arrives for free on the way in and only fails on the way out"
        }
      ]
    },
    "shoofi-shoofir": {
